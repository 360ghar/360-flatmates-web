# Security headers (W28), read by Cloudflare Workers static assets and by Netlify.
# CSP ships as Report-Only first so a missed origin cannot break production.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://plausible.io https://api.360ghar.com https://*.supabase.co wss://*.supabase.co https://*.googleapis.com https://nominatim.openstreetmap.org; frame-src https://*.supabase.co https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
