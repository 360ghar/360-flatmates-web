// Cloudflare Worker that serves flatmates.360ghar.com: static assets only.
// Workers Builds: `npm run build`, then `npx wrangler deploy`.
// Local production deploy: `CONTEXT=production npm run build` (fetches listings), then `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "360-flatmates-web",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    // dist/<route>.html is served at /<route> with no slash redirect, matching the canonicals.
    "html_handling": "auto-trailing-slash",
    // Client-side routes (/login, /discover?...) get index.html with 200.
    "not_found_handling": "single-page-application"
  },
  // The proxied DNS record stays; the route sends every request to this Worker.
  "routes": [{ "pattern": "flatmates.360ghar.com/*", "zone_name": "360ghar.com" }],
  // No public workers.dev copy of the site; PR builds still get preview URLs.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`, which Workers Builds runs for non-main branches.
  "previews": {},
  "observability": { "enabled": true }
}
